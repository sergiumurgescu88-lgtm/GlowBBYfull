<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glowbby Model Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml">
    <style>
        body { background-color: #0f0f0f; background-image: radial-gradient(at 0% 0%, rgba(255, 159, 67, 0.1) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(255, 107, 53, 0.05) 0px, transparent 50%); color: #ffffff; font-family: 'Inter', system-ui, sans-serif; }
        .glass-panel { background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(12px); border: 1px solid rgba(255, 159, 67, 0.15); box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2); }
        .glow-text { background: linear-gradient(to right, #ffb86c, #ff9f43); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .btn-primary { background: linear-gradient(135deg, #ffb86c 0%, #ff9f43 100%); color: #0a0a0a; font-weight: bold; transition: all 0.3s ease; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(255, 159, 67, 0.3); }
        .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .nav-item { transition: all 0.2s; border-left: 3px solid transparent; }
        .nav-item.active { background: rgba(255, 159, 67, 0.1); border-left-color: #ff9f43; color: #ff9f43; }
        .nav-item:hover { background: rgba(255, 255, 255, 0.05); }
        .loader { border: 3px solid rgba(255, 255, 255, 0.1); border-top: 3px solid #ff9f43; border-radius: 50%; width: 24px; height: 24px; animation: spin 1s linear infinite; display: inline-block; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        select, textarea { background-color: rgba(0,0,0,0.4); border: 1px solid #374151; color: white; transition: border-color 0.2s; }
        select:focus, textarea:focus { border-color: #ff9f43; outline: none; }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row">

    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 glass-panel flex-shrink-0 flex flex-col border-r border-gray-800">
        <div class="p-6 border-b border-gray-800">
            <h1 class="text-2xl font-bold glow-text">Glowbby Studio</h1>
            <p class="text-xs text-gray-400 mt-1">Professional AI Creator</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <button onclick="switchTool('outfit')" id="nav-outfit" class="nav-item active w-full text-left px-4 py-3 rounded-lg flex items-center gap-3">
                <span>👗</span> Schimbă Outfit-ul
            </button>
            <button onclick="switchTool('background')" id="nav-background" class="nav-item w-full text-left px-4 py-3 rounded-lg flex items-center gap-3">
                <span>🌅</span> Schimbă Fundalul
            </button>
            <button onclick="switchTool('video')" id="nav-video" class="nav-item w-full text-left px-4 py-3 rounded-lg flex items-center gap-3">
                <span>🎬</span> Video Motion (Soon)
            </button>
        </nav>
        <div class="p-4 border-t border-gray-800 text-xs text-gray-500 text-center">
            Powered by KIE.ai & Flux Pro
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- LEFT COLUMN: Master Image & Controls -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- Master Image Upload -->
                <div class="glass-panel rounded-2xl p-6">
                    <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">📸 Poza Master (Referință)</h2>
                    <div class="border-2 border-dashed border-gray-600 rounded-xl p-8 text-center hover:border-[#ff9f43] transition cursor-pointer relative bg-black/20">
                        <input type="file" id="master-image" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" onchange="previewMasterImage(this)">
                        <div id="master-preview" class="hidden w-full h-64 object-contain rounded-lg mb-2 mx-auto max-w-sm"></div>
                        <div id="master-placeholder">
                            <svg class="w-12 h-12 mx-auto text-gray-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <p class="text-gray-300 font-medium">Click sau trage aici Poza Master</p>
                            <p class="text-gray-500 text-sm mt-1">Fața clară, lumină bună, ținută simplă</p>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Tool Controls -->
                <div class="glass-panel rounded-2xl p-6">
                    <h2 class="text-lg font-semibold mb-4 flex items-center gap-2" id="tool-title">👗 Schimbă Outfit-ul</h2>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">1. Alege un stil predefinit sau scrie custom</label>
                            <select id="preset-prompt" class="w-full rounded-lg p-3 text-sm mb-3" onchange="updateCustomPrompt()">
                                <option value="custom">-- Scrie descrierea ta custom --</option>
                                <option value="wearing an elegant black evening dress, professional studio lighting, highly detailed, 8k resolution">Rochie de seară neagră, elegantă</option>
                                <option value="wearing a casual white t-shirt and denim jeans, natural sunlight, highly detailed, 8k resolution">Outfit casual (Tricou alb și blugi)</option>
                                <option value="wearing a professional business suit, modern office background, sharp focus, 8k resolution">Costum de birou profesional</option>
                                <option value="wearing a cozy oversized sweater, warm coffee shop background, soft lighting, highly detailed">Pulover pufos, atmosferă caldă</option>
                            </select>
                            <textarea id="custom-prompt" class="w-full rounded-lg p-3 text-sm" rows="3" placeholder="Descrie outfit-ul sau fundalul dorit în limba engleză..."></textarea>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-2">2. Dimensiune (Aspect Ratio)</label>
                                <select id="aspect-ratio" class="w-full rounded-lg p-3 text-sm">
                                    <option value="1:1">1:1 (Pătrat - Instagram)</option>
                                    <option value="9:16" selected>9:16 (Portrait - TikTok/Reels)</option>
                                    <option value="16:9">16:9 (Landscape - YouTube)</option>
                                </select>
                            </div>
                            <div class="flex items-end">
                                <button onclick="generateContent()" id="generate-btn" class="btn-primary w-full py-3 rounded-lg flex items-center justify-center gap-2">
                                    <span>✨ Generează</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Results Gallery -->
            <div class="lg:col-span-5">
                <div class="glass-panel rounded-2xl p-6 h-full flex flex-col">
                    <h2 class="text-lg font-semibold mb-4 flex items-center gap-2">🖼️ Rezultate</h2>
                    
                    <div id="results-container" class="flex-1 bg-black/20 rounded-xl border border-gray-800 flex items-center justify-center relative overflow-hidden min-h-[400px]">
                        <div id="results-placeholder" class="text-center text-gray-500 p-8">
                            <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <p>Rezultatele vor apărea aici</p>
                        </div>
                        
                        <div id="results-loading" class="hidden absolute inset-0 bg-black/60 flex flex-col items-center justify-center gap-4 z-10">
                            <div class="loader w-10 h-10 border-4"></div>
                            <p class="text-sm text-gray-300 animate-pulse">Se procesează... (poate dura 30-60 secunde)</p>
                        </div>

                        <img id="result-image" class="hidden max-w-full max-h-full object-contain rounded-lg" />
                    </div>

                    <a id="download-btn" class="hidden btn-primary w-full mt-4 py-3 rounded-lg text-center block" download="glowbby-result.jpg">
                        ⬇️ Descarcă Imaginea
                    </a>
                </div>
            </div>

        </div>
    </main>

    <script>
        let currentTool = 'outfit';

        function switchTool(tool) {
            currentTool = tool;
            
            // Update sidebar active state
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById('nav-' + tool).classList.add('active');

            // Update title and placeholders
            const titleEl = document.getElementById('tool-title');
            const promptEl = document.getElementById('custom-prompt');
            
            if (tool === 'outfit') {
                titleEl.innerHTML = '👗 Schimbă Outfit-ul';
                promptEl.placeholder = "Ex: wearing an elegant red dress, professional studio lighting, highly detailed";
            } else if (tool === 'background') {
                titleEl.innerHTML = '🌅 Schimbă Fundalul';
                promptEl.placeholder = "Ex: standing in a luxury modern apartment with large windows, sunset lighting, highly detailed";
            } else if (tool === 'video') {
                titleEl.innerHTML = '🎬 Video Motion (În curând)';
                promptEl.placeholder = "Funcționalitate video în dezvoltare...";
            }
        }

        function updateCustomPrompt() {
            const preset = document.getElementById('preset-prompt').value;
            const customEl = document.getElementById('custom-prompt');
            if (preset !== 'custom') {
                customEl.value = preset;
            } else {
                customEl.value = '';
                customEl.focus();
            }
        }

        function previewMasterImage(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('master-preview');
                    preview.innerHTML = '<img src="' + e.target.result + '" class="w-full h-full object-contain rounded-lg" />';
                    preview.classList.remove('hidden');
                    document.getElementById('master-placeholder').classList.add('hidden');
                }
                reader.readAsDataURL(file);
            }
        }

        async function generateContent() {
            const masterInput = document.getElementById('master-image');
            const prompt = document.getElementById('custom-prompt').value.trim();
            const ratio = document.getElementById('aspect-ratio').value;

            if (!masterInput.files[0]) return alert('Te rog să încarci mai întâi Poza Master!');
            if (!prompt) return alert('Te rog să introduci o descriere pentru generare!');
            if (currentTool === 'video') return alert('Funcționalitatea video este în curs de dezvoltare.');

            const btn = document.getElementById('generate-btn');
            const loading = document.getElementById('results-loading');
            const placeholder = document.getElementById('results-placeholder');
            const resultImg = document.getElementById('result-image');
            const downloadBtn = document.getElementById('download-btn');

            // UI Loading State
            btn.disabled = true;
            btn.innerHTML = '<div class="loader w-5 h-5 border-2"></div> Se generează...';
            loading.classList.remove('hidden');
            placeholder.classList.add('hidden');
            resultImg.classList.add('hidden');
            downloadBtn.classList.add('hidden');

            const formData = new FormData();
            formData.append('image', masterInput.files[0]);
            formData.append('prompt', prompt);
            formData.append('aspect_ratio', ratio);

            // Determinăm endpoint-ul în funcție de tool
            const endpoint = currentTool === 'outfit' || currentTool === 'background' ? '/api/replace-bg' : '/api/generate';

            try {
                const response = await fetch(endpoint, { method: 'POST', body: formData });
                const data = await response.json();
                
                if (data.detail) throw new Error(data.detail);
                
                resultImg.src = data.image;
                resultImg.classList.remove('hidden');
                downloadBtn.href = data.image;
                downloadBtn.classList.remove('hidden');
            } catch (err) {
                alert('Eroare la generare: ' + err.message);
                placeholder.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span>✨ Generează</span>';
                loading.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
