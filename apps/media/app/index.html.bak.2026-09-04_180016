<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glowbby Media Studio</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Cdefs%3E%3ClinearGradient id=%27cameraGrad%27 x1=%270%25%27 y1=%270%25%27 x2=%27100%25%27 y2=%27100%25%27%3E%3Cstop offset=%270%25%27 style=%27stop-color:%238b5cf6;stop-opacity:1%27 /%3E%3Cstop offset=%27100%25%27 style=%27stop-color:%23ec4899;stop-opacity:1%27 /%3E%3C/linearGradient%3E%3C/defs%3E%3Crect x=%2715%27 y=%2730%27 width=%2770%27 height=%2750%27 rx=%278%27 fill=%27url(%23cameraGrad)%27 opacity=%270.9%27/%3E%3Ccircle cx=%2750%27 cy=%2755%27 r=%2715%27 fill=%27%231f2937%27 opacity=%270.95%27/%3E%3Ccircle cx=%2750%27 cy=%2755%27 r=%2710%27 fill=%27url(%23cameraGrad)%27 opacity=%270.6%27/%3E%3Ccircle cx=%2750%27 cy=%2755%27 r=%275%27 fill=%27%23ffffff%27 opacity=%270.9%27/%3E%3Crect x=%2735%27 y=%2722%27 width=%2730%27 height=%2712%27 rx=%274%27 fill=%27url(%23cameraGrad)%27 opacity=%270.8%27/%3E%3Ccircle cx=%2775%27 cy=%2738%27 r=%273%27 fill=%27%23fbbf24%27 opacity=%270.9%27/%3E%3C/svg%3E">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .loader { border: 4px solid #f3f3f3; border-top: 4px solid #8b5cf6; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .tab-active { background-color: #8b5cf6; color: white; }
        .tab-inactive { background-color: #1f2937; color: #9ca3af; }
        .tab-inactive:hover { background-color: #374151; }
        .prompt-btn { 
            font-size: 0.75rem; 
            background-color: #374151; 
            color: #d1d5db; 
            padding: 0.25rem 0.75rem; 
            border-radius: 9999px; 
            transition: all 0.2s;
            max-width: 200px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .prompt-btn:hover { 
            background-color: #4b5563; 
            color: #ffffff;
            transform: translateY(-1px);
        }
        .lucky-btn {
            position: absolute;
            bottom: 0.5rem;
            right: 0.5rem;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            z-index: 10;
        }
        .lucky-btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.5);
        }
        .lucky-btn:active {
            transform: scale(0.95);
        }
        @keyframes pulse-lucky {
            0%, 100% { box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3); }
            50% { box-shadow: 0 2px 16px rgba(245, 158, 11, 0.6); }
        }
        .lucky-btn.active {
            animation: pulse-lucky 0.6s ease-in-out;
        }
        .ai-btn {
            position: absolute;
            bottom: 0.5rem;
            left: 0.5rem;
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.375rem 0.75rem;
            border-radius: 0.5rem;
            box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.25rem;
            z-index: 10;
        }
        .ai-btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 4px 12px rgba(139, 92, 246, 0.5);
        }
        .ai-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        .ai-modal.active {
            display: flex;
        }
        .ai-modal-content {
            background: #1f2937;
            border-radius: 1rem;
            padding: 2rem;
            max-width: 600px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            border: 2px solid #8b5cf6;
        }
        .ai-response {
            background: #111827;
            border: 1px solid #374151;
            border-radius: 0.5rem;
            padding: 1rem;
            margin-top: 1rem;
            white-space: pre-wrap;
            font-family: 'Courier New', monospace;
            font-size: 0.875rem;
            line-height: 1.6;
        }
        .typing-indicator {
            display: flex;
            gap: 4px;
            padding: 0.5rem;
        }
        .typing-indicator span {
            width: 8px;
            height: 8px;
            background: #8b5cf6;
            border-radius: 50%;
            animation: typing 1.4s infinite ease-in-out;
        }
        .typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
        .typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
        @keyframes typing {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }
    </style>
</head>
<body class="bg-gray-900 text-white font-sans h-screen flex overflow-hidden">
    <aside class="w-64 bg-gray-800 border-r border-gray-700 flex flex-col">
        <div class="p-6 border-b border-gray-700">
            <h1 class="text-2xl font-bold text-purple-400">Glowbby Studio</h1>
            <p class="text-xs text-gray-400 mt-1">Platformă AI pentru Creatori</p>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            <button onclick="switchTab('outfit')" id="btn-outfit" class="w-full text-left px-4 py-3 rounded-lg tab-active transition flex items-center gap-3">👗 Outfit Change</button>
            <button onclick="switchTab('background')" id="btn-background" class="w-full text-left px-4 py-3 rounded-lg tab-inactive transition flex items-center gap-3">🌅 Fundal</button>
            <button onclick="switchTab('video')" id="btn-video" class="w-full text-left px-4 py-3 rounded-lg tab-inactive transition flex items-center gap-3">🎬 Video Motion</button>
        </nav>
    </aside>
    <main class="flex-1 flex flex-col overflow-hidden">
        <header class="bg-gray-800 border-b border-gray-700 p-4 flex justify-between items-center">
            <h2 id="page-title" class="text-xl font-semibold">Outfit Change</h2>
            <div class="flex items-center gap-4">
                <label class="cursor-pointer bg-purple-600 hover:bg-purple-700 px-4 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">
                    📷 Încarcă Master Image
                    <input type="file" id="master-image" accept="image/*" class="hidden" onchange="previewImage(this)">
                </label>
                <div class="relative">
                    <img id="master-preview" class="w-10 h-10 rounded-full object-cover border-2 border-purple-500 hidden">
                    <button onclick="clearMasterImage()" id="clear-master-btn" class="hidden absolute -top-1 -right-1 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs hover:bg-red-600">×</button>
                </div>
            </div>
        </header>
        <div class="flex-1 overflow-y-auto p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-300 mb-2">Prompt / Descriere</label>
                    <div class="relative">
                        <textarea id="prompt" rows="4" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 pb-12 text-white focus:ring-2 focus:ring-purple-500 focus:outline-none" placeholder="Ex: Modelul poartă o rochie elegantă de seară, iluminare cinematică..."></textarea>
                        <button onclick="openAIAssistant(this)" type="button" class="ai-btn" title="AI Assistant - Îmbunătățește promptul">
                            🤖 <span>AI</span>
                        </button>
                        <button onclick="feelingLucky(this)" type="button" class="lucky-btn" title="Generează un prompt aleatoriu">
                            🎲 <span>Feeling Lucky</span>
                        </button>
                    </div>
                    <div id="prompt-suggestions" class="flex flex-wrap gap-2 mt-2">
                        <!-- Butoanele vor fi generate aici dinamic -->
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Aspect Ratio</label>
                        <select id="aspect-ratio" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 text-white focus:outline-none">
                            <option value="1:1">1:1 (Pătrat)</option>
                            <option value="16:9">16:9 (Landscape)</option>
                            <option value="9:16">9:16 (Portrait)</option>
                        </select>
                    </div>
                    <div id="video-controls" class="hidden">
                        <label class="block text-sm font-medium text-gray-300 mb-2">Durată Video</label>
                        <select id="video-duration" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 text-white focus:outline-none">
                            <option value="5">5 secunde</option>
                            <option value="10">10 secunde</option>
                        </select>
                    </div>
                </div>
                <button onclick="generateContent()" id="generate-btn" class="w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold py-3 rounded-lg transition flex justify-center items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                    <span>✨ Generează</span>
                </button>
                <div id="progress-container" class="hidden">
                    <div class="flex justify-between text-sm text-gray-400 mb-1">
                        <span id="progress-text">Se procesează...</span>
                        <span id="progress-time">0s</span>
                    </div>
                    <div class="w-full bg-gray-700 rounded-full h-2.5">
                        <div id="progress-bar" class="bg-purple-600 h-2.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 flex flex-col items-center justify-center min-h-[400px] relative">
                <div id="result-placeholder" class="text-gray-500 text-center">
                    <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <p>Rezultatul va apărea aici</p>
                </div>
                <div id="result-content" class="hidden w-full h-full flex flex-col items-center">
                    <img id="result-image" class="max-w-full max-h-[500px] rounded-lg shadow-2xl hidden">
                    <video id="result-video" class="max-w-full max-h-[500px] rounded-lg shadow-2xl hidden" controls></video>
                    <a id="download-btn" href="#" download="glowbby-result" class="mt-4 bg-gray-700 hover:bg-gray-600 px-6 py-2 rounded-lg text-sm font-medium transition flex items-center gap-2">⬇️ Descarcă Rezultatul</a>
                </div>
                <div id="loader" class="hidden absolute inset-0 bg-gray-800 bg-opacity-90 flex flex-col items-center justify-center rounded-xl">
                    <div class="loader mb-4"></div>
                    <p class="text-purple-400 font-medium">AI-ul lucrează...</p>
                    <p class="text-xs text-gray-400 mt-2">Acest proces poate dura până la 2-3 minute pentru video.</p>
                </div>
            </div>
        </div>
    </main>

    <!-- AI Assistant Modal -->
    <div id="ai-modal" class="ai-modal">
        <div class="ai-modal-content">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-xl font-bold text-purple-400 flex items-center gap-2">
                    🤖 AI Assistant
                </h3>
                <button onclick="closeAIAssistant()" class="text-gray-400 hover:text-white text-2xl">×</button>
            </div>
            <p class="text-sm text-gray-400 mb-4">Descrie ideea ta, iar AI-ul va crea un prompt profesional detaliat.</p>
            <textarea id="ai-input" rows="4" class="w-full bg-gray-900 border border-gray-600 rounded-lg p-3 text-white focus:ring-2 focus:ring-purple-500 focus:outline-none" placeholder="Ex: rochie roșie elegantă pentru o petrecere de seară..."></textarea>
            <button onclick="callAIAssistant()" id="ai-submit-btn" class="mt-4 w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white font-bold py-3 rounded-lg transition flex justify-center items-center gap-2">
                <span>✨ Generează Prompt Profesional</span>
            </button>
            <div id="ai-response-container" class="hidden">
                <h4 class="text-sm font-semibold text-gray-300 mt-4 mb-2">Prompt Generat:</h4>
                <div id="ai-response" class="ai-response"></div>
                <button onclick="useAIPrompt()" class="mt-4 w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 rounded-lg transition">
                    ✅ Folosește Acest Prompt
                </button>
            </div>
            <div id="ai-loading" class="hidden">
                <div class="typing-indicator">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <p class="text-sm text-gray-400 text-center">AI-ul se gândește...</p>
            </div>
        </div>
    </div>

    <script>
        let currentTab = 'outfit';
        let startTime = 0;
        let progressInterval;

        const promptSuggestions = {
            outfit: [
                'Elegant black evening dress, professional studio lighting, high fashion photography, 8k resolution',
                'Casual streetwear outfit, denim jacket and white t-shirt, urban fashion style, natural lighting',
                'Professional business suit, navy blue blazer with white shirt, corporate portrait, clean background',
                'Summer beach outfit, flowing sundress, golden hour lighting, vacation vibes',
                'Athletic wear, sports bra and leggings, fitness photography, dynamic pose',
                'Vintage 1950s dress, retro style, pin-up aesthetic, classic colors',
                'Bohemian festival outfit, colorful patterns, flower crown, outdoor setting',
                'Minimalist monochrome outfit, all white ensemble, modern fashion, clean lines',
                'Luxury lingerie set, silk and lace, elegant boudoir photography, soft lighting',
                'Winter fashion, cozy sweater and scarf, cold weather outfit, studio photography'
            ],
            background: [
                'Professional photography studio, seamless white backdrop, studio lighting setup',
                'Luxury hotel room interior, modern minimalist design, natural window light',
                'Tropical beach at sunset, golden hour, ocean waves, palm trees in background',
                'Urban city street at night, neon lights, bokeh effect, cinematic atmosphere',
                'Forest clearing, natural sunlight filtering through trees, outdoor portrait',
                'Rooftop terrace with city skyline, urban backdrop, evening atmosphere',
                'Vintage library interior, wooden bookshelves, classic academic setting',
                'Modern art gallery, white walls, contemporary artwork, minimalist space',
                'Flower garden in full bloom, colorful petals, romantic outdoor setting',
                'Industrial warehouse, exposed brick walls, steel beams, urban loft aesthetic'
            ],
            video: [
                'Subtle smile, gentle eye movement, natural facial expressions, cinematic close-up',
                'Wind blowing through hair, slow motion, outdoor atmosphere, dynamic movement',
                'Slow turn of the head, looking over shoulder, elegant pose, professional modeling',
                'Walking forward confidently, fashion runway style, steady camera movement',
                'Laughing naturally, candid moment, genuine emotion, lifestyle photography',
                'Hand gently touching face, soft gesture, intimate portrait, slow motion',
                'Dancing gracefully, fluid body movement, artistic expression, smooth animation',
                'Looking around curiously, exploring environment, natural head movement',
                'Blinking naturally, maintaining eye contact, subtle facial animation',
                'Posing with hands on hips, confident stance, slight body sway, power pose'
            ]
        };

        function updatePromptSuggestions() {
            const container = document.getElementById('prompt-suggestions');
            container.innerHTML = '';
            const prompts = promptSuggestions[currentTab] || [];
            
            prompts.forEach((prompt, index) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'prompt-btn';
                btn.textContent = prompt.split(',')[0];
                btn.title = prompt;
                btn.onclick = () => {
                    document.getElementById('prompt').value = prompt;
                };
                container.appendChild(btn);
            });
        }

        function feelingLucky(btn) {
            const prompts = promptSuggestions[currentTab] || [];
            if (prompts.length === 0) return;
            
            btn.classList.add('active');
            setTimeout(() => btn.classList.remove('active'), 600);
            
            const randomIndex = Math.floor(Math.random() * prompts.length);
            const textarea = document.getElementById('prompt');
            textarea.value = prompts[randomIndex];
            
            textarea.style.borderColor = '#f59e0b';
            setTimeout(() => {
                textarea.style.borderColor = '';
            }, 800);
        }

        function openAIAssistant(btn) {
            document.getElementById('ai-modal').classList.add('active');
            document.getElementById('ai-input').value = '';
            document.getElementById('ai-response-container').classList.add('hidden');
            document.getElementById('ai-input').focus();
        }

        function closeAIAssistant() {
            document.getElementById('ai-modal').classList.remove('active');
        }

        async function callAIAssistant() {
            const input = document.getElementById('ai-input').value.trim();
            if (!input) {
                alert('Te rog să scrii o idee sau descriere!');
                return;
            }

            document.getElementById('ai-submit-btn').disabled = true;
            document.getElementById('ai-loading').classList.remove('hidden');
            document.getElementById('ai-response-container').classList.add('hidden');

            const formData = new FormData();
            formData.append('message', input);
            formData.append('context_type', currentTab);

            try {
                const response = await fetch('/api/ai-assistant', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (!response.ok) throw new Error(data.detail || 'Eroare AI');

                document.getElementById('ai-loading').classList.add('hidden');
                document.getElementById('ai-response-container').classList.remove('hidden');
                document.getElementById('ai-response').textContent = data.response;
            } catch (error) {
                document.getElementById('ai-loading').classList.add('hidden');
                alert('Eroare: ' + error.message);
            } finally {
                document.getElementById('ai-submit-btn').disabled = false;
            }
        }

        function useAIPrompt() {
            const aiResponse = document.getElementById('ai-response').textContent;
            document.getElementById('prompt').value = aiResponse;
            closeAIAssistant();
            
            const textarea = document.getElementById('prompt');
            textarea.style.borderColor = '#8b5cf6';
            setTimeout(() => {
                textarea.style.borderColor = '';
            }, 800);
        }

        window.addEventListener('DOMContentLoaded', () => {
            const savedImage = localStorage.getItem('masterImageBase64');
            if (savedImage) {
                const preview = document.getElementById('master-preview');
                preview.src = savedImage;
                preview.classList.remove('hidden');
                document.getElementById('clear-master-btn').classList.remove('hidden');
            }
            updatePromptSuggestions();
        });

        function switchTab(tab) {
            currentTab = tab;
            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('tab-active');
                btn.classList.add('tab-inactive');
            });
            document.getElementById(`btn-${tab}`).classList.remove('tab-inactive');
            document.getElementById(`btn-${tab}`).classList.add('tab-active');

            const titles = { 'outfit': 'Outfit Change', 'background': 'Schimbare Fundal', 'video': 'Video Motion' };
            document.getElementById('page-title').textContent = titles[tab];
            
            const videoControls = document.getElementById('video-controls');
            if (tab === 'video') {
                videoControls.classList.remove('hidden');
                document.getElementById('prompt').placeholder = "Ex: Modelul zâmbește ușor, vântul îi mișcă părul, mișcare cinematică lentă...";
            } else {
                videoControls.classList.add('hidden');
                document.getElementById('prompt').placeholder = "Ex: Modelul poartă o rochie elegantă de seară, iluminare cinematică...";
            }
            
            updatePromptSuggestions();
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('master-preview');
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    document.getElementById('clear-master-btn').classList.remove('hidden');
                    localStorage.setItem('masterImageBase64', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearMasterImage() {
            localStorage.removeItem('masterImageBase64');
            document.getElementById('master-preview').classList.add('hidden');
            document.getElementById('clear-master-btn').classList.add('hidden');
            document.getElementById('master-image').value = '';
        }

        function startProgress() {
            startTime = Date.now();
            document.getElementById('progress-container').classList.remove('hidden');
            document.getElementById('loader').classList.remove('hidden');
            progressInterval = setInterval(() => {
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                document.getElementById('progress-time').textContent = elapsed + 's';
                const progress = Math.min((elapsed / (currentTab === 'video' ? 120 : 40)) * 90, 90);
                document.getElementById('progress-bar').style.width = progress + '%';
            }, 1000);
        }

        function stopProgress() {
            clearInterval(progressInterval);
            document.getElementById('progress-container').classList.add('hidden');
            document.getElementById('loader').classList.add('hidden');
            document.getElementById('progress-bar').style.width = '100%';
        }

        async function generateContent() {
            const fileInput = document.getElementById('master-image');
            const prompt = document.getElementById('prompt').value;
            const aspectRatio = document.getElementById('aspect-ratio').value;
            
            let imageFile = null;
            
            if (fileInput.files && fileInput.files[0]) {
                imageFile = fileInput.files[0];
            } else {
                const savedImage = localStorage.getItem('masterImageBase64');
                if (savedImage) {
                    const res = await fetch(savedImage);
                    const blob = await res.blob();
                    imageFile = new File([blob], "master-image.jpg", { type: "image/jpeg" });
                }
            }

            if (!imageFile) {
                alert('Te rog să încarci mai întâi o Master Image!');
                return;
            }
            if (!prompt) {
                alert('Te rog să introduci un prompt!');
                return;
            }

            const formData = new FormData();
            formData.append('image', imageFile);
            formData.append('prompt', prompt);
            formData.append('aspect_ratio', aspectRatio);

            let endpoint = '/api/generate';
            if (currentTab === 'outfit') endpoint = '/api/replace-bg';
            else if (currentTab === 'video') {
                endpoint = '/api/generate-video';
                formData.append('duration', document.getElementById('video-duration').value);
            }

            document.getElementById('result-placeholder').classList.add('hidden');
            document.getElementById('result-content').classList.add('hidden');
            startProgress();

            try {
                const response = await fetch(endpoint, { method: 'POST', body: formData });
                const data = await response.json();

                if (!response.ok) throw new Error(data.detail || 'Eroare la generare');

                stopProgress();
                document.getElementById('result-content').classList.remove('hidden');

                if (currentTab === 'video' && data.video_url) {
                    const videoEl = document.getElementById('result-video');
                    videoEl.src = data.video_url;
                    videoEl.classList.remove('hidden');
                    document.getElementById('result-image').classList.add('hidden');
                    document.getElementById('download-btn').href = data.video_url;
                    document.getElementById('download-btn').download = 'glowbby-video.mp4';
                } else if (data.image) {
                    const imgEl = document.getElementById('result-image');
                    imgEl.src = data.image;
                    imgEl.classList.remove('hidden');
                    document.getElementById('result-video').classList.add('hidden');
                    document.getElementById('download-btn').href = data.image;
                    document.getElementById('download-btn').download = 'glowbby-image.jpg';
                }
            } catch (error) {
                stopProgress();
                alert('Eroare: ' + error.message);
                document.getElementById('result-placeholder').classList.remove('hidden');
            }
        }
    </script>
</body>
</html>
