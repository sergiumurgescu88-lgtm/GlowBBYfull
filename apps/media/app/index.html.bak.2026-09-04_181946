        function updatePromptSuggestions() {
            const container = document.getElementById('prompt-suggestions');
            container.innerHTML = '';
            const prompts = promptSuggestions[currentTab] || [];
            prompts.forEach(prompt => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'prompt-btn';
                btn.textContent = prompt.split(',')[0];
                btn.title = prompt;
                btn.onclick = () => {
                    document.getElementById('prompt').value = prompt;
                    btn.classList.add('ring-2', 'ring-purple-500');
                    setTimeout(() => btn.classList.remove('ring-2', 'ring-purple-500'), 800);
                };
                container.appendChild(btn);
            });
        }

        function feelingLucky(btn) {
            const prompts = promptSuggestions[currentTab] || [];
            if (prompts.length === 0) return;
            btn.style.transform = 'scale(0.9)';
            setTimeout(() => btn.style.transform = '', 200);
            const randomIndex = Math.floor(Math.random() * prompts.length);
            const textarea = document.getElementById('prompt');
            textarea.value = prompts[randomIndex];
            textarea.style.borderColor = '#f59e0b';
            setTimeout(() => { textarea.style.borderColor = ''; }, 800);
        }

        function openAIAssistant() {
            document.getElementById('ai-modal').classList.add('active');
            document.getElementById('ai-input').value = '';
            document.getElementById('ai-response-container').classList.add('hidden');
            setTimeout(() => document.getElementById('ai-input').focus(), 100);
        }

        function closeAIAssistant() {
            document.getElementById('ai-modal').classList.remove('active');
        }

        async function callAIAssistant() {
            const input = document.getElementById('ai-input').value.trim();
            if (!input) { alert('Te rog să scrii o idee!'); return; }

            document.getElementById('ai-submit-btn').disabled = true;
            document.getElementById('ai-loading').classList.remove('hidden');
            document.getElementById('ai-response-container').classList.add('hidden');

            const formData = new FormData();
            formData.append('message', input);
            formData.append('context_type', currentTab);

            try {
                const response = await fetch('/api/ai-assistant', { method: 'POST', body: formData });
                const data = await response.json();
                if (!response.ok) throw new Error(data.detail || 'Eroare AI');

                document.getElementById('ai-loading').classList.add('hidden');
                document.getElementById('ai-response-container').classList.remove('hidden');
                document.getElementById('ai-response').textContent = data.response;
            } catch (error) {
                document.getElementById('ai-loading').classList.add('hidden');
                alert('Eroare: ' + error.message);
            } finally {
                document.getElementById('ai-submit-btn').disabled = false;
            }
        }

        function useAIPrompt() {
            const aiResponse = document.getElementById('ai-response').textContent;
            document.getElementById('prompt').value = aiResponse;
            closeAIAssistant();
            const textarea = document.getElementById('prompt');
            textarea.style.borderColor = '#8b5cf6';
            setTimeout(() => { textarea.style.borderColor = ''; }, 800);
        }

        function toggleMobileDrawer() {
            const drawer = document.getElementById('mobile-drawer');
            const overlay = document.getElementById('drawer-overlay');
            const isOpen = drawer.classList.contains('open');
            if (isOpen) {
                drawer.classList.remove('open');
                overlay.classList.remove('open');
                document.body.style.overflow = '';
            } else {
                drawer.classList.add('open');
                overlay.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function showUploadActionSheet() {
            const sheet = document.getElementById('upload-action-sheet');
            sheet.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function hideUploadActionSheet() {
            const sheet = document.getElementById('upload-action-sheet');
            sheet.classList.remove('active');
            document.body.style.overflow = '';
        }

        function triggerCamera() {
            document.getElementById('file-camera').click();
        }

        function triggerGallery() {
            document.getElementById('file-gallery').click();
        }

        function handleFileSelect(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64 = e.target.result;
                    localStorage.setItem('masterImageBase64', base64);
                    syncAllPreviews(base64);
                    
                    // Update upload button text on mobile
                    const btnText = document.getElementById('upload-btn-text');
                    if (btnText) btnText.textContent = 'Schimbă';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function syncAllPreviews(base64) {
            ['master-preview', 'master-preview-desktop', 'master-preview-drawer'].forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.src = base64;
                    el.classList.remove('hidden');
                }
            });
            ['clear-master-btn', 'clear-master-btn-drawer'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.remove('hidden');
            });
        }

        function previewImage(input, source) {
            handleFileSelect(input);
        }

        function clearMasterImage() {
            localStorage.removeItem('masterImageBase64');
            ['master-preview', 'master-preview-desktop', 'master-preview-drawer'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });
            ['clear-master-btn', 'clear-master-btn-drawer'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });
            ['file-camera', 'file-gallery', 'master-image'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            
            // Reset upload button text
            const btnText = document.getElementById('upload-btn-text');
            if (btnText) btnText.textContent = 'Upload';
        }

        function switchTab(tab, fromDrawer = false) {
            currentTab = tab;
            // Update desktop sidebar buttons
            document.querySelectorAll('aside.hidden.md\\:flex nav button').forEach(btn => {
                btn.classList.remove('tab-active');
                btn.classList.add('tab-inactive');
            });
            const desktopBtn = document.getElementById(`btn-${tab}`);
            if (desktopBtn) {
                desktopBtn.classList.remove('tab-inactive');
                desktopBtn.classList.add('tab-active');
            }

            // Update mobile drawer buttons
            document.querySelectorAll('.mobile-tab-btn').forEach(btn => {
                btn.classList.remove('tab-active');
                btn.classList.add('tab-inactive');
            });
            document.querySelectorAll('.mobile-tab-btn').forEach(btn => {
                if (btn.onclick && btn.onclick.toString().includes(`'${tab}'`)) {
                    btn.classList.remove('tab-inactive');
                    btn.classList.add('tab-active');
                }
            });

            // Update mobile quick icons
            document.querySelectorAll('.mobile-tab-icon').forEach(btn => {
                btn.classList.remove('bg-purple-600');
                btn.classList.add('bg-gray-700');
            });
            const icons = {'outfit': '👗', 'background': '🌅', 'video': '🎬'};
            document.querySelectorAll('.mobile-tab-icon').forEach(btn => {
                if (btn.textContent.trim() === icons[tab]) {
                    btn.classList.remove('bg-gray-700');
                    btn.classList.add('bg-purple-600');
                }
            });

            const titles = { 'outfit': 'Outfit Change', 'background': 'Schimbare Fundal', 'video': 'Video Motion' };
            const titleDesktop = document.getElementById('page-title');
            const titleMobile = document.getElementById('page-title-mobile');
            if (titleDesktop) titleDesktop.textContent = titles[tab];
            if (titleMobile) titleMobile.textContent = titles[tab];
            
            const videoControls = document.getElementById('video-controls');
            if (tab === 'video') {
                videoControls.classList.remove('hidden');
                document.getElementById('prompt').placeholder = "Ex: zâmbet subtil, mișcare cinematică...";
            } else {
                videoControls.classList.add('hidden');
                document.getElementById('prompt').placeholder = "Ex: rochie elegantă de seară...";
            }
            
            updatePromptSuggestions();

            // Close drawer on mobile after selecting
            if (fromDrawer && window.innerWidth < 768) {
                setTimeout(toggleMobileDrawer, 200);
            }
        }

        function startProgress() {
            startTime = Date.now();
            document.getElementById('progress-container').classList.remove('hidden');
            document.getElementById('loader').classList.remove('hidden');
            progressInterval = setInterval(() => {
                const elapsed = Math.floor((Date.now() - startTime) / 1000);
                document.getElementById('progress-time').textContent = elapsed + 's';
                const progress = Math.min((elapsed / (currentTab === 'video' ? 120 : 40)) * 90, 90);
                document.getElementById('progress-bar').style.width = progress + '%';
            }, 1000);
        }

        function stopProgress() {
            clearInterval(progressInterval);
            document.getElementById('progress-container').classList.add('hidden');
            document.getElementById('loader').classList.add('hidden');
        }

        async function generateContent() {
            const prompt = document.getElementById('prompt').value;
            const aspectRatio = document.getElementById('aspect-ratio').value;
            
            let imageFile = null;
            
            // Try to get file from camera or gallery inputs
            const inputs = ['file-camera', 'file-gallery', 'master-image'];
            for (const id of inputs) {
                const input = document.getElementById(id);
                if (input && input.files && input.files[0]) {
                    imageFile = input.files[0];
                    break;
                }
            }
            
            // Fallback to localStorage
            if (!imageFile) {
                const savedImage = localStorage.getItem('masterImageBase64');
                if (savedImage) {
                    try {
                        const res = await fetch(savedImage);
                        const blob = await res.blob();
                        imageFile = new File([blob], "master-image.jpg", { type: blob.type || "image/jpeg" });
                    } catch(e) {
                        console.error('Error loading from localStorage:', e);
                    }
                }
            }

            if (!imageFile) { 
                if (window.innerWidth < 768) {
                    showUploadActionSheet();
                } else {
                    alert('Te rog să încarci o Master Image!');
                }
                return; 
            }
            if (!prompt) { alert('Te rog să introduci un prompt!'); return; }

            const formData = new FormData();
            formData.append('image', imageFile);
            formData.append('prompt', prompt);
            formData.append('aspect_ratio', aspectRatio);

            let endpoint = '/api/generate';
            if (currentTab === 'outfit') endpoint = '/api/replace-bg';
            else if (currentTab === 'video') {
                endpoint = '/api/generate-video';
                formData.append('duration', document.getElementById('video-duration').value);
            }

            document.getElementById('result-placeholder').classList.add('hidden');
            document.getElementById('result-content').classList.add('hidden');
            startProgress();

            try {
                const response = await fetch(endpoint, { method: 'POST', body: formData });
                const data = await response.json();
                if (!response.ok) throw new Error(data.detail || 'Eroare la generare');

                stopProgress();
                document.getElementById('result-content').classList.remove('hidden');

                if (currentTab === 'video' && data.video_url) {
                    const videoEl = document.getElementById('result-video');
                    videoEl.src = data.video_url;
                    videoEl.classList.remove('hidden');
                    document.getElementById('result-image').classList.add('hidden');
                    document.getElementById('download-btn').href = data.video_url;
                    document.getElementById('download-btn').download = 'glowbby-video.mp4';
                } else if (data.image) {
                    const imgEl = document.getElementById('result-image');
                    imgEl.src = data.image;
                    imgEl.classList.remove('hidden');
                    document.getElementById('result-video').classList.add('hidden');
                    document.getElementById('download-btn').href = data.image;
                    document.getElementById('download-btn').download = 'glowbby-image.jpg';
                }
                
                // Scroll to result on mobile
                if (window.innerWidth < 1024) {
                    setTimeout(() => {
                        document.getElementById('result-content').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }, 100);
                }
            } catch (error) {
                stopProgress();
                alert('Eroare: ' + error.message);
                document.getElementById('result-placeholder').classList.remove('hidden');
            }
        }

        // Init
        window.addEventListener('DOMContentLoaded', () => {
            const savedImage = localStorage.getItem('masterImageBase64');
            if (savedImage) {
                syncAllPreviews(savedImage);
                const btnText = document.getElementById('upload-btn-text');
                if (btnText) btnText.textContent = 'Schimbă';
            }
            updatePromptSuggestions();
        });

        // Close modal on escape and click outside action sheet
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeAIAssistant();
                hideUploadActionSheet();
                const drawer = document.getElementById('mobile-drawer');
                if (drawer.classList.contains('open')) toggleMobileDrawer();
            }
        });

        // Click outside action sheet to close
        document.getElementById('upload-action-sheet').addEventListener('click', (e) => {
            if (e.target.id === 'upload-action-sheet') {
                hideUploadActionSheet();
            }
        });
    </script>
</body>
