<script>
    // Lightbox functions
    let lightboxMedia = null;

    function openLightbox(type) {
        const lightbox = document.getElementById('lightbox');
        const imgEl = document.getElementById('lightbox-image');
        const videoEl = document.getElementById('lightbox-video');
        
        // Reset both
        imgEl.classList.add('hidden');
        videoEl.classList.add('hidden');
        videoEl.pause();
        
        if (type === 'image') {
            const sourceImg = document.getElementById('result-image');
            if (sourceImg.src) {
                imgEl.src = sourceImg.src;
                imgEl.classList.remove('hidden');
                lightboxMedia = { type: 'image', src: sourceImg.src };
            }
        } else if (type === 'video') {
            const sourceVideo = document.getElementById('result-video');
            if (sourceVideo.src) {
                videoEl.src = sourceVideo.src;
                videoEl.classList.remove('hidden');
                lightboxMedia = { type: 'video', src: sourceVideo.src };
                setTimeout(() => videoEl.play().catch(e => console.log('Autoplay prevented')), 100);
            }
        }
        
        lightbox.classList.remove('hidden');
        lightbox.classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
        const lightbox = document.getElementById('lightbox');
        const videoEl = document.getElementById('lightbox-video');
        videoEl.pause();
        videoEl.src = '';
        lightbox.classList.add('hidden');
        lightbox.classList.remove('show');
        document.body.style.overflow = '';
        lightboxMedia = null;
    }

    function downloadFromLightbox(event) {
        event.stopPropagation();
        if (lightboxMedia) {
            const downloadBtn = document.getElementById('download-btn');
            if (downloadBtn) {
                downloadBtn.click();
            }
        }
    }

    // Add Escape key handler for lightbox
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const lightbox = document.getElementById('lightbox');
            if (!lightbox.classList.contains('hidden')) {
                closeLightbox();
                return;
            }
        }
    });
</script>
