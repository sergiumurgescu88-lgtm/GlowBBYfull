<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GlowBBY Intelligence Platform | Glowbby</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
    <style>
        * { font-family: 'Inter', sans-serif; }
        body { background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); }
        .glass { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(148, 163, 184, 0.1); }
        .glow { box-shadow: 0 0 40px rgba(59, 130, 246, 0.15); }
        textarea { resize: none; }
        .btn-primary { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); transition: all 0.3s ease; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(59, 130, 246, 0.4); }
        .loader { width: 24px; height: 24px; border: 3px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .fade-in { animation: fadeIn 0.5s ease-in; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        pre { font-family: 'Inter', sans-serif; line-height: 1.8; }
    </style>
</head>
<body class="min-h-screen p-8 text-slate-100">
    <div class="max-w-5xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-12 fade-in">
            <div class="inline-flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-2xl glow">🧠</div>
                <h1 class="text-4xl font-bold bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">GlowBBY Intelligence Platform</h1>
            </div>
            <p class="text-slate-400 text-lg">Advanced chat analysis & strategy engine</p>
        </div>

        <!-- Main Card -->
        <div class="glass rounded-2xl p-8 glow fade-in">
            <!-- Input Section -->
            <div class="mb-6">
                <label class="block text-sm font-semibold text-slate-300 mb-3 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    Chat Log Input
                </label>
                <textarea 
                    id="chatLog" 
                    rows="12" 
                    class="w-full p-4 bg-slate-900/50 border border-slate-700 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all placeholder-slate-500 text-slate-200" 
                    placeholder="Paste the complete conversation here..."></textarea>
            </div>

            <!-- Action Button -->
            <button 
                id="btn" 
                class="btn-primary w-full py-4 px-6 rounded-xl text-white font-semibold flex items-center justify-center gap-3 disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                <span id="btnText">Generate Strategy</span>
                <div id="loader" class="loader hidden"></div>
            </button>
        </div>

        <!-- Results Section -->
        <div id="resultContainer" class="mt-8 hidden fade-in">
            <div class="glass rounded-2xl p-8 glow">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-700">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-bold text-slate-100">Analysis Complete</h2>
                </div>
                <pre id="result" class="text-slate-300 whitespace-pre-wrap leading-relaxed"></pre>
            </div>
        
        <!-- Feedback Section -->
        <div id="feedbackSection" class="mt-6 hidden">
            <div class="glass rounded-xl p-6">
                <h3 class="text-lg font-semibold mb-4 text-slate-200">A funcționat acest mesaj?</h3>
                <div class="flex gap-3">
                    <button onclick="sendFeedback(90, 'ppv_20')" class="flex-1 bg-green-600 hover:bg-green-700 text-white py-3 px-4 rounded-lg font-semibold transition">
                        ✅ Da, a cumpărat PPV
                    </button>
                    <button onclick="sendFeedback(70, 'tip_5')" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 px-4 rounded-lg font-semibold transition">
                        💰 A dat tip
                    </button>
                    <button onclick="sendFeedback(30, 'no_sale')" class="flex-1 bg-red-600 hover:bg-red-700 text-white py-3 px-4 rounded-lg font-semibold transition">
                        ❌ Nu a funcționat
                    </button>
                </div>
            </div>
        </div>

        </div>

        <!-- Footer -->
        <div class="text-center mt-12 text-slate-500 text-sm">
            <p>Powered by GlowBBY</p>
        </div>
    </div>

    <script>
        const btn = document.getElementById('btn');
        const btnText = document.getElementById('btnText');
        const loader = document.getElementById('loader');
        const resultContainer = document.getElementById('resultContainer');
        const result = document.getElementById('result');

        btn.onclick = async () => {
            const log = document.getElementById('chatLog').value.trim();
            if (!log) {
                alert('Please paste a conversation to analyze');
                return;
            }

            btn.disabled = true;
            btnText.textContent = 'Analyzing...';
            loader.classList.remove('hidden');
            resultContainer.classList.add('hidden');

            try {
                const r = await fetch('/api/generate', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({chat_log: log})
                });
                const d = await r.json();
                lastConversationId = d.conversation_id;
                document.getElementById("feedbackSection").classList.remove("hidden");
                
                if (d.error) {
                    result.textContent = 'Error: ' + d.error;
                    result.classList.add('text-red-400');
                } else {
                    result.textContent = d.result;
                    result.classList.remove('text-red-400');
                }
                
                resultContainer.classList.remove('hidden');
                resultContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
            } catch(e) {
                result.textContent = 'Network Error: ' + e.message;
                result.classList.add('text-red-400');
                resultContainer.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btnText.textContent = 'Generate Strategy';
                loader.classList.add('hidden');
            }
        };

        let lastConversationId = null;
        
        async function sendFeedback(score, conversion) {
            if (!lastConversationId) return;
            
            try {
                await fetch('/api/feedback', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        conversation_id: lastConversationId,
                        message_id: null,
                        score: score,
                        conversion_result: conversion
                    })
                });
                alert('✅ Feedback salvat! Sistemul învață din această conversație.');
            } catch(e) {
                alert('Eroare: ' + e.message);
            }
        }

    </script>
</body>
</html>
