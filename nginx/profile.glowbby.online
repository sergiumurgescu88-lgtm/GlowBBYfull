server {
    server_name profile.glowbby.online 187.77.64.99;

    # Calea către fișierele compilate de Vite
    root /var/www/profile.glowbby.online/dist;
    index index.html;

    location / {
        # Aceasta asigură că rutarea React (React Router) funcționează corect
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/profile.glowbby.online/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/profile.glowbby.online/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = profile.glowbby.online) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name profile.glowbby.online 187.77.64.99;
    return 404; # managed by Certbot


}