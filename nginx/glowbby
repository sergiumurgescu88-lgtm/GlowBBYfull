server {
    listen 80;
    listen 443 ssl;
    server_name glowbby.online www.glowbby.online;

    # Certificatul SSL generat de Certbot
    ssl_certificate /etc/letsencrypt/live/glowbby.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/glowbby.online/privkey.pem;

    client_max_body_size 10M;

    # Ruta pentru API-ul nostru Glowbby
    location /v1/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
    }

    # Pagina principală (doar un mesaj de confirmare)
    location / {
        default_type text/plain;
        return 200 "✅ Glowbby API is running successfully.\nFolosește extensia Chrome pentru a interacționa cu sistemul.";
    }
}
