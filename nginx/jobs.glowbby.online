# Redirectare de la HTTP la HTTPS
server {
    listen 80;
    server_name jobs.glowbby.online;
    return 301 https://$host$request_uri;
}

# Configurare HTTPS cu certificat SSL valid
server {
    listen 443 ssl;
    server_name jobs.glowbby.online;

    # Certificatele generate anterior de Certbot
    ssl_certificate /etc/letsencrypt/live/jobs.glowbby.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jobs.glowbby.online/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
